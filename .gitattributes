# Files that are not part of the installed core package (composer archive / GitHub zip).
# The test kit in src/ stays shipped. Each adapter folder is its own package (its split repo),
# so the core download leaves it out.
/.github/ export-ignore
/docs/ export-ignore
/tests/ export-ignore
/tools/ export-ignore
/storage/ export-ignore
/transport/ export-ignore
/webhook/ export-ignore
/ratelimit/ export-ignore
/.dockerignore export-ignore
/.gitattributes export-ignore
/CLAUDE.md export-ignore
/Dockerfile export-ignore
/Makefile export-ignore
/compose.yaml export-ignore
/deptrac.yaml export-ignore
/ecs.php export-ignore
/phpstan.dist.neon export-ignore
/infection.json5 export-ignore
/infection.repo.json5 export-ignore
/phpunit.xml.dist export-ignore
