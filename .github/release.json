{
  "packages": [
    {
      "name": "message-broker",
      "path": ".",
      "tag": "v{version}",
      "ignore": [
        "tests/**",
        "*.md",
        "docs/**",
        ".idea/**",
        "tools/**",
        ".github/**",
        "storage/**",
        "transport/**",
        "webhook/**",
        "ratelimit/**",
        "Makefile",
        "compose.yaml",
        "Dockerfile",
        ".dockerignore",
        "deptrac.yaml",
        "ecs.php",
        "phpstan.dist.neon",
        "phpunit.xml.dist",
        "infection.json5",
        "infection.repo.json5"
      ],
      "initial": "0.5.0"
    },
    {
      "name": "storage-postgresql",
      "path": "storage/postgresql",
      "tag": "storage-postgresql-v{version}",
      "ignore": ["storage/postgresql/tests/**", "storage/postgresql/docs/**", "storage/postgresql/*.md"],
      "initial": "0.1.0"
    },
    {
      "name": "transport-amqp",
      "path": "transport/amqp",
      "tag": "transport-amqp-v{version}",
      "ignore": ["transport/amqp/tests/**", "transport/amqp/docs/**", "transport/amqp/*.md"],
      "initial": "0.1.0"
    },
    {
      "name": "webhook-http",
      "path": "webhook/http",
      "tag": "webhook-http-v{version}",
      "ignore": ["webhook/http/tests/**", "webhook/http/docs/**", "webhook/http/*.md"],
      "initial": "0.1.0"
    },
    {
      "name": "ratelimit-redis",
      "path": "ratelimit/redis",
      "tag": "ratelimit-redis-v{version}",
      "ignore": ["ratelimit/redis/tests/**", "ratelimit/redis/docs/**", "ratelimit/redis/*.md"],
      "initial": "0.1.0"
    }
  ]
}
