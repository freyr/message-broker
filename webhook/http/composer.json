{
    "name": "freyr/message-broker-webhook-http",
    "description": "HTTP webhook sender for freyr/message-broker: signed parallel requests (Standard Webhooks) with Symfony HttpClient",
    "keywords": [
        "webhooks",
        "standard-webhooks",
        "http",
        "event-driven"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Freyr Development Team"
        }
    ],
    "require": {
        "php": ">=8.4",
        "freyr/message-broker": "^0.15",
        "psr/log": "^3.0",
        "symfony/clock": "^8.1",
        "symfony/http-client": "^8.1",
        "symfony/http-foundation": "^8.1"
    },
    "require-dev": {
        "freyr/message-broker-storage-postgresql": "^0.1",
        "infection/infection": "^0.35.11",
        "phpunit/phpunit": "^13.4"
    },
    "suggest": {
        "ext-intl": "Internationalized host names in subscription URLs (or symfony/polyfill-intl-idn)",
        "symfony/polyfill-intl-idn": "Internationalized host names in subscription URLs, when ext-intl is not loaded"
    },
    "provide": {
        "freyr/message-broker-webhook-sender-implementation": "1.0"
    },
    "autoload": {
        "psr-4": {
            "Freyr\\MessageBroker\\Webhook\\Http\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Freyr\\MessageBroker\\Webhook\\Http\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "optimize-autoloader": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
