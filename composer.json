{
    "name": "freyr/message-broker",
    "description": "Standalone messaging library: transactional outbox, deduplication, per-transport producers and consumers (AMQP) with retries, DLQ and replay",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "outbox-pattern",
        "inbox-pattern",
        "event-driven",
        "deduplication",
        "amqp",
        "dlq"
    ],
    "authors": [
        {
            "name": "Freyr Development Team"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "ext-pdo_pgsql": "*",
        "psr/log": "^3.0",
        "symfony/clock": "^8.1",
        "symfony/console": "^7.4|^8.1",
        "symfony/uid": "^7.4|^8.1"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7",
        "infection/infection": "^0.35.11",
        "php-amqplib/php-amqplib": "^3.7.2",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.4",
        "predis/predis": "^3.2",
        "symfony/http-client": "^8.1",
        "symfony/http-foundation": "^8.1",
        "symplify/easy-coding-standard": "^13.3"
    },
    "suggest": {
        "ext-pcntl": "Graceful shutdown of the relay and the consumer on SIGTERM and SIGINT",
        "php-amqplib/php-amqplib": "Required for the AMQP transport",
        "symfony/http-client": "Required for the HTTP webhook sender",
        "symfony/http-foundation": "Required for the HTTP webhook sender (the private network check)",
        "ext-redis": "A \\Redis, \\RedisCluster or Relay client for the Redis rate limit store (PhpRedisScriptRunner)",
        "predis/predis": "A Predis client for the Redis rate limit store (PredisScriptRunner)",
        "phpunit/phpunit": "Required for Freyr\\MessageBroker\\Testing\\*, the test kit of contract test cases and fakes"
    },
    "replace": {
        "freyr/message-broker-postgresql": "self.version",
        "freyr/message-broker-amqp": "self.version",
        "freyr/message-broker-http": "self.version",
        "freyr/message-broker-redis": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Freyr\\MessageBroker\\": "src/broker/",
            "Freyr\\MessageBroker\\Adapter\\PostgreSql\\": "src/adapter/postgresql/",
            "Freyr\\MessageBroker\\Adapter\\Amqp\\": "src/adapter/amqp/",
            "Freyr\\MessageBroker\\Adapter\\Http\\": "src/adapter/http/",
            "Freyr\\MessageBroker\\Adapter\\Redis\\": "src/adapter/redis/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Freyr\\MessageBroker\\Tests\\": "tests/broker/",
            "Freyr\\MessageBroker\\Adapter\\PostgreSql\\Tests\\": "tests/adapter/postgresql/",
            "Freyr\\MessageBroker\\Adapter\\Amqp\\Tests\\": "tests/adapter/amqp/",
            "Freyr\\MessageBroker\\Adapter\\Http\\Tests\\": "tests/adapter/http/",
            "Freyr\\MessageBroker\\Adapter\\Redis\\Tests\\": "tests/adapter/redis/"
        }
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "optimize-autoloader": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "scripts": {
        "phpstan": "phpstan analyse --memory-limit=-1",
        "ecs": "ecs check",
        "ecs:fix": "ecs check --fix",
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
