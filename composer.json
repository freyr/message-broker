{
    "name": "freyr/message-broker",
    "description": "Core of the messaging library: contracts, transactional outbox relay, consumer with deduplication, retries, DLQ and replay, webhook delivery queue, and an in-memory test kit",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "outbox-pattern",
        "inbox-pattern",
        "event-driven",
        "deduplication",
        "dlq"
    ],
    "authors": [
        {
            "name": "Freyr Development Team"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-mbstring": "*",
        "psr/log": "^3.0",
        "symfony/clock": "^8.1",
        "symfony/console": "^7.4|^8.1",
        "symfony/uid": "^7.4|^8.1"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7",
        "freyr/message-broker-ratelimit-redis": "*@dev",
        "freyr/message-broker-storage-postgresql": "*@dev",
        "freyr/message-broker-transport-amqp": "*@dev",
        "freyr/message-broker-webhook-http": "*@dev",
        "infection/infection": "^0.35.11",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.4",
        "predis/predis": "^3.2",
        "symplify/easy-coding-standard": "^13.3"
    },
    "suggest": {
        "ext-pcntl": "Graceful shutdown of the relay and the consumer on SIGTERM and SIGINT",
        "freyr/message-broker-storage-postgresql": "Storage adapter: the outbox, deduplication, dead-letter and webhook delivery stores on PostgreSQL",
        "freyr/message-broker-transport-amqp": "Transport adapter: AMQP (RabbitMQ) publisher and consumer",
        "freyr/message-broker-webhook-http": "Webhook sender: signed HTTP requests with Symfony HttpClient",
        "freyr/message-broker-ratelimit-redis": "Rate limit store of the webhook lanes on Redis or Valkey",
        "phpunit/phpunit": "Required for Freyr\\MessageBroker\\Testing\\*, the test kit of contract test cases and fakes"
    },
    "repositories": {
        "storage-postgresql": {
            "type": "path",
            "url": "storage/postgresql",
            "options": {
                "symlink": true
            }
        },
        "transport-amqp": {
            "type": "path",
            "url": "transport/amqp",
            "options": {
                "symlink": true
            }
        },
        "webhook-http": {
            "type": "path",
            "url": "webhook/http",
            "options": {
                "symlink": true
            }
        },
        "ratelimit-redis": {
            "type": "path",
            "url": "ratelimit/redis",
            "options": {
                "symlink": true
            }
        }
    },
    "autoload": {
        "psr-4": {
            "Freyr\\MessageBroker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Freyr\\MessageBroker\\Tests\\": "tests/",
            "Freyr\\MessageBroker\\Storage\\PostgreSql\\Tests\\": "storage/postgresql/tests/",
            "Freyr\\MessageBroker\\Transport\\Amqp\\Tests\\": "transport/amqp/tests/",
            "Freyr\\MessageBroker\\Webhook\\Http\\Tests\\": "webhook/http/tests/",
            "Freyr\\MessageBroker\\RateLimit\\Redis\\Tests\\": "ratelimit/redis/tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "optimize-autoloader": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "scripts": {
        "phpstan": "phpstan analyse --memory-limit=-1",
        "ecs": "ecs check",
        "ecs:fix": "ecs check --fix",
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
