{
    "name": "freyr/message-broker",
    "description": "Standalone messaging library: transactional outbox, deduplication, per-transport producers and consumers (AMQP) with retries, DLQ and replay",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "outbox-pattern",
        "inbox-pattern",
        "event-driven",
        "deduplication",
        "amqp",
        "dlq"
    ],
    "authors": [
        {
            "name": "Freyr Development Team"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "ext-pdo_pgsql": "*",
        "psr/log": "^3.0",
        "symfony/clock": "^8.1",
        "symfony/console": "^7.4|^8.1",
        "symfony/uid": "^7.4|^8.1"
    },
    "require-dev": {
        "php-amqplib/php-amqplib": "^3.7",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.4",
        "symplify/easy-coding-standard": "^13.3"
    },
    "suggest": {
        "php-amqplib/php-amqplib": "Required for the AMQP transport"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "Freyr\\MessageBroker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Freyr\\MessageBroker\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "optimize-autoloader": true
    },
    "scripts": {
        "phpstan": "phpstan analyse --memory-limit=-1",
        "ecs": "ecs check",
        "ecs:fix": "ecs check --fix",
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
