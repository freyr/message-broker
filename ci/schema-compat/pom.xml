<?xml version="1.0" encoding="UTF-8"?>
<!--
  Offline Avro backward/forward-compatibility gate (CI only). Uses Confluent's
  schema-registry-maven-plugin `test-local-compatibility` goal, which checks a
  subject's CURRENT schema against its retained PRIOR versions with NO running
  Schema Registry. The JVM/Maven toolchain lives only here (in CI) — the library
  and consuming applications stay pure-PHP at runtime.

  Maintenance contract: when a subject gains a new version vN, point `schemas`
  at the new current file and add every prior version to `previousSchemaPaths`.
  Prior versions must stay committed (the immutable per-version layout) or the
  comparison has nothing to check against and passes vacuously.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>freyr.messagebroker</groupId>
  <artifactId>schema-compat</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>

  <properties>
    <schemasDir>${project.basedir}/../../tests/Fixtures/schemas</schemasDir>
  </properties>

  <pluginRepositories>
    <pluginRepository>
      <id>confluent</id>
      <url>https://packages.confluent.io/maven/</url>
    </pluginRepository>
  </pluginRepositories>

  <build>
    <plugins>
      <plugin>
        <groupId>io.confluent</groupId>
        <artifactId>kafka-schema-registry-maven-plugin</artifactId>
        <version>7.7.1</version>
        <configuration>
          <schemaTypes>
            <order.placed>AVRO</order.placed>
          </schemaTypes>
          <compatibilityLevels>
            <order.placed>FULL_TRANSITIVE</order.placed>
          </compatibilityLevels>
          <!-- The subject's current schema (highest committed version). -->
          <schemas>
            <order.placed>${schemasDir}/order.placed/v2.avsc</order.placed>
          </schemas>
          <!-- Every retained prior version of the subject. -->
          <previousSchemaPaths>
            <order.placed>${schemasDir}/order.placed/v1.avsc</order.placed>
          </previousSchemaPaths>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
