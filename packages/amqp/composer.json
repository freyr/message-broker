{
    "name": "freyr/message-broker-amqp",
    "description": "AMQP (RabbitMQ) transport adapter for freyr/message-broker: outbox relay publisher and consumer",
    "keywords": [
        "amqp",
        "rabbitmq",
        "event-driven"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Freyr Development Team"
        }
    ],
    "require": {
        "php": ">=8.4",
        "freyr/message-broker": "^0.13",
        "php-amqplib/php-amqplib": "^3.7.2",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "freyr/message-broker-postgresql": "^0.13",
        "infection/infection": "^0.35.11",
        "phpunit/phpunit": "^13.4",
        "symfony/clock": "^8.1",
        "symfony/uid": "^7.4|^8.1"
    },
    "suggest": {
        "ext-pcntl": "Graceful shutdown of the relay and the consumer on SIGTERM and SIGINT"
    },
    "provide": {
        "freyr/message-broker-transport-implementation": "1.0"
    },
    "autoload": {
        "psr-4": {
            "Freyr\\MessageBroker\\Adapter\\Amqp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Freyr\\MessageBroker\\Adapter\\Amqp\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "optimize-autoloader": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
