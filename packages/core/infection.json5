{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"],
        // The test kit (src/Testing) is test code: it is not mutated.
        // The name is relative to the source directory.
        "excludes": ["Testing"]
    },
    // Parallel workers are isolated: each TEST_TOKEN gets its own database and queue names.
    "timeout": 20,
    "logs": {
        "text": "var/infection/infection.log",
        "html": "var/infection/infection.html",
        "summary": "var/infection/summary.log"
    },
    "tmpDir": "var/infection/tmp",
    "mutators": {
        "@default": true,
        // Equivalent mutants of the level search in PermitDivision::divide(): the list is sorted, so
        // once the stop condition is true it stays true for each later lane. "continue" in place of
        // "break" then skips each later lane with the same result, and ">=" in place of ">" stops at
        // a tie (availability * lanes == remaining), which gives the same level and a rest of 0.
        // Only the stop condition of the level search; the other ">" of divide() keep their mutants.
        "GreaterThan": {
            "ignoreSourceCodeByRegex": [".*\\$availability \\* \\$lanesAboveLevel > \\$remaining.*"]
        },
        "Break_": {
            "ignore": ["Freyr\\MessageBroker\\Webhook\\PermitDivision::divide"]
        }
    },
    "testFramework": "phpunit",
    "testFrameworkOptions": "--no-progress",
    // Measured for this package alone (split rehearsal, its own tests only). Raise it as tests improve; never lower it.
    "minMsi": 92,
    "minCoveredMsi": 92
}
