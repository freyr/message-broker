{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    // One process: the functional tests share one database and fixed queue names.
    "timeout": 20,
    "logs": {
        "text": "var/infection/infection.log",
        "html": "var/infection/infection.html",
        "summary": "var/infection/summary.log"
    },
    "tmpDir": "var/infection/tmp",
    "mutators": {
        "@default": true
    },
    "testFramework": "phpunit",
    "testFrameworkOptions": "--no-progress",
    // Baseline of the first full run (804 mutants, 543 killed). Raise it as tests improve.
    "minMsi": 67,
    "minCoveredMsi": 67
}
