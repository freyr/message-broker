{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src/broker", "src/adapter/postgresql", "src/adapter/amqp", "src/adapter/http"],
        // The test kit (src/broker/Testing, src/adapter/postgresql/Testing) is test code: it is not mutated.
        // The names are relative to each source directory.
        "excludes": ["Testing"]
    },
    // Parallel workers are isolated: each TEST_TOKEN gets its own database and queue names.
    "timeout": 20,
    "logs": {
        "text": "var/infection/infection.log",
        "html": "var/infection/infection.html",
        "summary": "var/infection/summary.log"
    },
    "tmpDir": "var/infection/tmp",
    "mutators": {
        "@default": true
    },
    "testFramework": "phpunit",
    "testFrameworkOptions": "--no-progress",
    // Measured 95.7% (852 mutants, 37 escaped); one point of margin for timeout variance.
    // Raise it as tests improve; never lower it.
    "minMsi": 94,
    "minCoveredMsi": 94
}
