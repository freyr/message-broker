<?xml version="1.0" encoding="UTF-8"?>
<!--
    The development configuration of the whole repo: one suite for each package. Each package
    has its own configuration for its tests alone: tests/phpunit.xml.dist (the core) and
    <role>/<technology>/phpunit.xml.dist (each adapter).
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/13.4/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
         failOnDeprecation="true"
         beStrictAboutCoverageMetadata="false"
         cacheDirectory=".phpunit.cache"
         executionOrder="defects"
         resolveDependencies="true">
    <testsuites>
        <testsuite name="core">
            <directory>tests</directory>
        </testsuite>
        <testsuite name="storage-postgresql">
            <directory>storage/postgresql/tests</directory>
        </testsuite>
        <testsuite name="transport-amqp">
            <directory>transport/amqp/tests</directory>
        </testsuite>
        <testsuite name="webhook-http">
            <directory>webhook/http/tests</directory>
        </testsuite>
        <testsuite name="ratelimit-redis">
            <directory>ratelimit/redis/tests</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>src</directory>
            <directory>storage/postgresql/src</directory>
            <directory>transport/amqp/src</directory>
            <directory>webhook/http/src</directory>
            <directory>ratelimit/redis/src</directory>
        </include>
        <exclude>
            <directory>src/Testing</directory>
            <directory>storage/postgresql/src/Testing</directory>
            <directory>ratelimit/redis/src/Testing</directory>
        </exclude>
    </source>

    <php>
        <!-- All suites with coverage (Infection) pass the default 128M of PHP. -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="test"/>
    </php>
</phpunit>
