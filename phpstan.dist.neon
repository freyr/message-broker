parameters:
    level: max
    paths:
        - src/
        - storage/postgresql/src/
        - transport/amqp/src/
        - webhook/http/src/
        - ratelimit/redis/src/
    ignoreErrors:
        # The traits of the test kit are used by test classes, which PHPStan does not analyse.
        -
            identifier: trait.unused
            paths:
                - src/Testing/TestIsolation.php
                - storage/postgresql/src/Testing/PostgreSqlTestSupport.php
