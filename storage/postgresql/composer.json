{
    "name": "freyr/message-broker-storage-postgresql",
    "description": "PostgreSQL storage adapter for freyr/message-broker: outbox, deduplication and dead-letter stores, schema installer and retention",
    "keywords": [
        "outbox-pattern",
        "postgresql",
        "deduplication",
        "dlq"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Freyr Development Team"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "freyr/message-broker": "^0.15",
        "symfony/clock": "^8.1",
        "symfony/uid": "^7.4|^8.1"
    },
    "require-dev": {
        "infection/infection": "^0.35.11",
        "phpunit/phpunit": "^13.4",
        "symfony/console": "^7.4|^8.1"
    },
    "suggest": {
        "phpunit/phpunit": "Required for Freyr\\MessageBroker\\Storage\\PostgreSql\\Testing\\*, the PostgreSQL test set-up"
    },
    "provide": {
        "freyr/message-broker-storage-implementation": "1.0"
    },
    "autoload": {
        "psr-4": {
            "Freyr\\MessageBroker\\Storage\\PostgreSql\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Freyr\\MessageBroker\\Storage\\PostgreSql\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "optimize-autoloader": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
